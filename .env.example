# =============================================================================
# Nimbus Markets ADK demo - copy to .env (never commit .env) and fill in ONE key.
#   cp .env.example .env
# =============================================================================

# --- Option A: direct Gemini (default) ----------------------------------------
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Option B: an OpenAI-compatible LiteLLM proxy ------------------------------
# Set both of these instead of GEMINI_API_KEY. LITELLM_GEMINI_API_KEY wins when
# both keys are set; with OPENAI_BASE_URL set, models use the openai/ prefix.
# LLM_API_KEY and LLM_BASE_URL work too, as shorter names for the same two settings.
# LITELLM_GEMINI_API_KEY=
# OPENAI_BASE_URL=https://your-litellm-proxy.example.com/v1

# --- Models (LiteLLM model strings) --------------------------------------------
# Leave commented out for the default (gemini/gemini-3.7-flash direct,
# openai/gemini-3.7-flash via a proxy). Uncomment ONE to override:
# AGENT_MODEL=gemini/gemini-3.7-flash
# AGENT_MODEL=openai/gemini-3.7-flash
# Optional faster/cheaper model for main_agent + orchestrator (defaults to AGENT_MODEL)
# ROUTER_MODEL=gemini/gemini-3.6-flash
# Reasoning effort for Gemini 3.x (low = fastest; default low). Leave empty for provider default.
# LLM_REASONING_EFFORT=low

# --- Postgres (working defaults; only change if you know why) ------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nimbus
# Host port for psql / DBeaver (container port is always 5432)
POSTGRES_PORT=5432

# --- Network --------------------------------------------------------------------
# Host address the containers' ports are published on. Keep 127.0.0.1 (this
# machine only). 0.0.0.0 exposes Postgres (postgres/postgres) and the
# unauthenticated API to everyone on your network - don't, on shared Wi-Fi.
BIND_ADDRESS=127.0.0.1

# LOG_LEVEL=INFO
