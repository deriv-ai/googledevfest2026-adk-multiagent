# =============================================================================
# Nimbus Markets ADK demo - copy to .env (never commit .env) and fill in the LLM part.
#   cp .env.example .env
# =============================================================================

# --- LLM ------------------------------------------------------------------------
# A key from any provider LiteLLM supports, and the model to use as provider/model.
# The model must support tool calling. Provider names: https://docs.litellm.ai/docs/providers
LLM_API_KEY=
# Examples: gemini/gemini-3.7-flash (the default when this is empty),
# anthropic/claude-sonnet-5-5, openai/<model>.
AGENT_MODEL=

# Only for an OpenAI-compatible endpoint (a LiteLLM proxy, OpenRouter, a local server):
# its URL, with AGENT_MODEL=openai/<the model name it expects>.
# LLM_BASE_URL=https://your-endpoint.example.com/v1

# Optional: a faster model for the main agent and the orchestrator (defaults to AGENT_MODEL).
# ROUTER_MODEL=
# Reasoning effort for reasoning models (default low = fastest). Leave empty for the
# provider's default, for example if your provider rejects it.
# LLM_REASONING_EFFORT=low

# Older names that still work: GEMINI_API_KEY, LITELLM_GEMINI_API_KEY, OPENAI_BASE_URL.

# --- Postgres (working defaults; only change if you know why) ------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nimbus
# Host port for psql / DBeaver (container port is always 5432)
POSTGRES_PORT=5432

# --- Network --------------------------------------------------------------------
# Host address the containers' ports are published on. Keep 127.0.0.1 (this
# machine only). 0.0.0.0 exposes Postgres (postgres/postgres) and the
# unauthenticated API to everyone on your network - don't, on shared Wi-Fi.
BIND_ADDRESS=127.0.0.1

# --- News MCP server ------------------------------------------------------------
# How often the news listener polls its RSS feeds (seconds)
NEWS_POLL_SECONDS=300

# LOG_LEVEL=INFO
